NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only Supabase service-role key, required for account deletion
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only Google Gemini API keys. The app tries them in order.
# Use either one comma-separated list:
GEMINI_API_KEYS=your-first-gemini-api-key,your-second-gemini-api-key
# Or numbered variables:
# GEMINI_API_KEY=your-first-gemini-api-key
# GEMINI_API_KEY_2=your-second-gemini-api-key
