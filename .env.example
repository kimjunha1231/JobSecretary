NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_WRITING_STUDIO_ENABLED=true
# Private Supabase Storage bucket for original resume/portfolio files.
# The migration defaults to `source-documents` when this is omitted.
# SUPABASE_SOURCE_STORAGE_BUCKET=source-documents
# Server-only Supabase service-role key, required for account deletion
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only Google Gemini API keys. The app tries them in order.
# Use either one comma-separated list:
GEMINI_API_KEYS=your-first-gemini-api-key,your-second-gemini-api-key
# Or numbered variables:
# GEMINI_API_KEY=your-first-gemini-api-key
# GEMINI_API_KEY_2=your-second-gemini-api-key

# Optional model overrides. Defaults stay pinned to these verified models.
# GEMINI_MODEL=gemini-3.7-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash

# Optional scan-PDF OCR provider. Defaults to Gemini when omitted; use `disabled` to keep manual correction only.
# SOURCE_OCR_PROVIDER=gemini
